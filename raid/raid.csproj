<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>RaidSeeder</Title>
		<PackageId>RaidSeeder</PackageId>
		<Version>4.5.0</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
		<Authors>Rainer Burkhardt</Authors>
		<Description>RAIkeep diagram artifact custodian for importing, exporting, refreshing, and validating .raid, PlantUML, and SVG.</Description>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<IsPackable>true</IsPackable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>raid</ToolCommandName>
		<PackageOutputPath>../artifacts/nuget</PackageOutputPath>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>HardCastle.png</PackageIcon>
		<PackageProjectUrl>https://github.com/Burkhardt/RaidSeeder</PackageProjectUrl>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Copyright>© Rainer Burkhardt</Copyright>
		<RepositoryUrl>https://github.com/Burkhardt/RaidSeeder.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageTags>raid;diagram;PlantUML;SVG;CLI;tool</PackageTags>
		<PackageReleaseNotes>Coordinated 4.5.0 dependency alignment; raid reports version 4.5.0.</PackageReleaseNotes>
		<RAIkeepRoot Condition="'$(RAIkeepRoot)' == '' and Exists('../../RaiDiagram/RaiDiagram.csproj')">../..</RAIkeepRoot>
		<RaiDiagramProjectPath Condition="'$(RAIkeepRoot)' != '' and Exists('$(RAIkeepRoot)/RaiDiagram/RaiDiagram.csproj')">$(RAIkeepRoot)/RaiDiagram/RaiDiagram.csproj</RaiDiagramProjectPath>
		<UseLocalRAIkeepSources Condition="'$(UseLocalRAIkeepSources)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">false</UseLocalRAIkeepSources>
		<UseLocalRAIkeepSources Condition="'$(UseLocalRAIkeepSources)' == '' and '$(RaiDiagramProjectPath)' != ''">true</UseLocalRAIkeepSources>
		<UseLocalRAIkeepSources Condition="'$(UseLocalRAIkeepSources)' == ''">false</UseLocalRAIkeepSources>
		<RaiDiagramPackageVersion Condition="'$(RaiDiagramPackageVersion)' == ''">4.5.0</RaiDiagramPackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" Link="README.md" />
		<None Include="../HardCastle.png" Pack="true" PackagePath="" Link="HardCastle.png" />
	</ItemGroup>

	<Target Name="ValidateLocalRAIkeepSources"
		BeforeTargets="Restore"
		Condition="'$(UseLocalRAIkeepSources)' == 'true'">
		<Error Condition="'$(RaiDiagramProjectPath)' == ''"
			Text="UseLocalRAIkeepSources=true requires a RaiDiagram project checkout. Set /p:RAIkeepRoot=/path/to/RAIkeep." />
	</Target>

	<ItemGroup Condition="'$(UseLocalRAIkeepSources)' == 'true'">
		<ProjectReference Include="$(RaiDiagramProjectPath)" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalRAIkeepSources)' != 'true'">
		<PackageReference Include="RaiDiagram" Version="$(RaiDiagramPackageVersion)" />
	</ItemGroup>

</Project>
